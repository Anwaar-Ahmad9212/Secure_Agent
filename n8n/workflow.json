        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3"
            },
            {
              "name": "prompt",
              "value": "={{ $json.body.message }}\n\nShould I make an HTTP request based on this? If yes, respond with ONLY the URL. If no, respond with 'NO'"
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        },
        "options": {}
      },
      "id": "ollama-node",
      "name": "Ollama AI Decision",
